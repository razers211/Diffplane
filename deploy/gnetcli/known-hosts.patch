diff --git a/pkg/server/known_hosts_test.go b/pkg/server/known_hosts_test.go
new file mode 100644
index 0000000..50ef9b0
--- /dev/null
+++ b/pkg/server/known_hosts_test.go
@@ -0,0 +1,147 @@
+package server
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"net"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	gossh "golang.org/x/crypto/ssh"
+	"golang.org/x/crypto/ssh/knownhosts"
+	"go.uber.org/zap"
+
+	"github.com/annetutil/gnetcli/pkg/credentials"
+)
+
+// startSSHServer runs a minimal SSH server on 127.0.0.1 that accepts any password
+// and every channel request. It returns its address and host key.
+func startSSHServer(t *testing.T) (string, int, gossh.PublicKey) {
+	t.Helper()
+	signer := newSigner(t)
+	conf := &gossh.ServerConfig{
+		PasswordCallback: func(gossh.ConnMetadata, []byte) (*gossh.Permissions, error) { return nil, nil },
+	}
+	conf.AddHostKey(signer)
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = ln.Close() })
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			go func(conn net.Conn) {
+				_, chans, reqs, err := gossh.NewServerConn(conn, conf)
+				if err != nil {
+					_ = conn.Close()
+					return
+				}
+				go gossh.DiscardRequests(reqs)
+				for newChan := range chans {
+					ch, chReqs, err := newChan.Accept()
+					if err != nil {
+						continue
+					}
+					go func() {
+						for req := range chReqs {
+							_ = req.Reply(true, nil)
+						}
+					}()
+					t.Cleanup(func() { _ = ch.Close() })
+				}
+			}(conn)
+		}
+	}()
+	host, portText, _ := net.SplitHostPort(ln.Addr().String())
+	port, _ := strconv.Atoi(portText)
+	return host, port, signer.PublicKey()
+}
+
+func newSigner(t *testing.T) gossh.Signer {
+	t.Helper()
+	_, key, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	signer, err := gossh.NewSignerFromKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return signer
+}
+
+func writeKnownHosts(t *testing.T, host string, port int, key gossh.PublicKey) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "known_hosts")
+	line := knownhosts.Line([]string{knownhosts.Normalize(net.JoinHostPort(host, strconv.Itoa(port)))}, key)
+	if err := os.WriteFile(path, []byte(line+"\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func connect(t *testing.T, s *Server, host string, port int) error {
+	t.Helper()
+	cfg := StreamerConfig{
+		connHost: host,
+		port:     port,
+		creds:    credentials.NewSimpleCredentials(credentials.WithUsername("user"), credentials.WithPassword("secret")),
+		logger:   zap.NewNop(),
+	}
+	conn, err := s.createStreamerSSH(cfg, nil)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	err = conn.Init(ctx)
+	conn.Close()
+	return err
+}
+
+func TestKnownHostsFileRejectsAnotherKey(t *testing.T) {
+	host, port, _ := startSSHServer(t)
+	other := newSigner(t).PublicKey()
+	s := &Server{log: zap.NewNop(), knownHostsFile: writeKnownHosts(t, host, port, other)}
+
+	err := connect(t, s, host, port)
+	if err == nil || !strings.Contains(err.Error(), "knownhosts") {
+		t.Fatalf("expected a knownhosts error, got %v", err)
+	}
+}
+
+func TestKnownHostsFileRejectsAnUnknownHost(t *testing.T) {
+	host, port, key := startSSHServer(t)
+	s := &Server{log: zap.NewNop(), knownHostsFile: writeKnownHosts(t, "192.0.2.1", port, key)}
+
+	err := connect(t, s, host, port)
+	if err == nil || !strings.Contains(err.Error(), "knownhosts") {
+		t.Fatalf("expected a knownhosts error, got %v", err)
+	}
+}
+
+func TestKnownHostsFileAcceptsThePinnedKey(t *testing.T) {
+	host, port, key := startSSHServer(t)
+	s := &Server{log: zap.NewNop(), knownHostsFile: writeKnownHosts(t, host, port, key)}
+
+	if err := connect(t, s, host, port); err != nil && strings.Contains(err.Error(), "knownhosts") {
+		t.Fatalf("pinned key refused: %v", err)
+	}
+}
+
+func TestMissingKnownHostsFileIsAnError(t *testing.T) {
+	s := &Server{log: zap.NewNop(), knownHostsFile: filepath.Join(t.TempDir(), "missing")}
+
+	if _, err := s.createStreamerSSH(StreamerConfig{connHost: "127.0.0.1", logger: zap.NewNop()}, nil); err == nil {
+		t.Fatal("expected an error for a missing known_hosts file")
+	}
+}
