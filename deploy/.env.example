# Local environment for deploy/compose.yaml.
# Generate deploy/.env with random secrets:  python3 deploy/gen_env.py
# Every empty value below is a secret that gen_env.py fills in.

# Release of the orchestrator and ZTP images pulled from ghcr.io (e.g. v0.2.0). Empty: the one
# deploy/compose.yaml names, which matches a checkout of that release tag.
DIFFPLANE_VERSION=

# NetBox (internal only, never published outside the Compose network)
NETBOX_SECRET_KEY=
NETBOX_DB_PASSWORD=
NETBOX_SUPERUSER_PASSWORD=
# API token for the orchestrator (and Annet). 40 hex characters.
NETBOX_TOKEN=

# Shared Redis/Valkey
REDIS_PASSWORD=

# Platform database (jobs, approvals, diff snapshots, users)
PLATFORM_DB_PASSWORD=
# Key the switches' kept running configs are encrypted with. Losing it loses those backups;
# keep a copy outside the server. An existing .env without it: see docs/operations.md, Config backups.
CONFIG_BACKUP_KEY=

# Device SSH login used by Annet/gnetcli. Fill in by hand;
# gen_env.py leaves these empty. Not needed for `annet gen`.
GNETCLI_DEV_LOGIN=
GNETCLI_DEV_PASSWORD=
# NETCONF login for the read-only collector. Fill in by hand (may be the same as above).
COLLECTOR_LOGIN=
COLLECTOR_PASSWORD=
# SNMP v2c read community for the switches (Snmp generator, collector). Fill in by hand.
SNMP_COMMUNITY=
# DFS group key shared by both leaves of an M-LAG pair (hmac-sha256). Fill in by hand.
MLAG_DFS_PASSWORD=

# Flows: the ClickHouse account of the flows service. gen_env.py fills it in.
CLICKHOUSE_PASSWORD=
# Where the flows service listens for the switches' NetStream (UDP): this host's address that the
# Fabric page's collector address names (localhost: no switch can reach it). Not secret.
FLOWS_BIND=127.0.0.1
FLOWS_PORT=2055
# Where the syslog receiver listens for the switches (UDP): this host's address that the Fabric
# page's syslog receiver names (localhost: no switch can reach it), and that page's port. Not secret.
SYSLOG_BIND=127.0.0.1
SYSLOG_PORT=514

# Where the switches pull software images from (SFTP): this host's address and port that the
# switches reach over MEth (the platform address in Settings). Localhost: no switch can reach it.
SFTP_BIND=127.0.0.1
SFTP_PORT=2222
# The address the switches are told to expect the image server at (Settings, Switch software).
SFTP_ADDRESS=

# Zero-touch provisioning, only with `docker compose --profile ztp up -d`. Fill in by hand.
# Admin account for people that the first-boot config creates (next to the two above).
ZTP_ADMIN_LOGIN=
ZTP_ADMIN_PASSWORD=
# Host interface on the management network, its network, and this host's address on it
# (the TFTP server the switches download from). Empty: DHCP stays off.
ZTP_DHCP_INTERFACE=
ZTP_DHCP_NETWORK=
ZTP_SERVER_ADDRESS=
# Hours a ZTP registration is served (DHCP and TFTP) before it expires; empty = 24. Not secret.
ZTP_WINDOW_HOURS=

# Bearer token Prometheus sends to the orchestrator's /metrics (filled by gen_env.py). Secret.
METRICS_TOKEN=

# Fabrics the orchestrator may deploy to (comma-separated site slugs). Empty: deploys off
# everywhere until an admin turns them on per fabric (Fabric page). Not secret.
DEPLOY_ALLOWED_SITES=
# Seconds between scheduled drift checks (fabric-wide annet diff). Not secret.
DRIFT_INTERVAL_SECONDS=900
# the smallest traffic change that counts as an anomaly, in bits/s (empty = 10000000) and as a
# share of the port's speed (empty = 0.01). Lower them only for a lab test.
ANOMALY_MIN_BPS=
ANOMALY_MIN_SHARE=
# The GUI is served over HTTPS only (self-signed): the session cookie is HTTPS-only too.
COOKIE_SECURE=true
# Names and addresses the self-signed certificate covers (comma-separated). Not secret.
TLS_HOSTNAMES=localhost,127.0.0.1,orchestrator

# Where the orchestrator (GUI and API, HTTPS) is published: 127.0.0.1 on a workstation,
# 0.0.0.0 on a server (every interface). Not secret.
ORCHESTRATOR_BIND=127.0.0.1
ORCHESTRATOR_PORT=8000
