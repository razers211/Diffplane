# This machine in the HA cluster. Copy to deploy/ha/node.env on each machine and set
# HA_NODE; everything else is the same on all three. Not in git (addresses of your network).
HA_NODE=server1                 # server1, server2 or witness
HA_SERVER1_IP=
HA_SERVER2_IP=
HA_WITNESS_IP=
HA_VIP=                         # a free address in the servers' subnet, excluded from any DHCP pool
HA_VIP_PREFIX=24                # the subnet's prefix length
HA_INTERFACE=ens18              # the servers' interface on that subnet (ip -br addr)
# HA_VRID=51                    # VRRP router ID 1-255; change only if 51 is taken on that subnet
# optional, all three or none (servers; the same lines may stay on the witness): the southbound VIP
# on the servers' second NIC, in the switches' management network. The platform's traffic to the
# switches leaves from it, and NetStream and ZTP point at it.
# HA_SB_INTERFACE=ens19
# HA_SB_VIP=
# HA_SB_PREFIX=24
